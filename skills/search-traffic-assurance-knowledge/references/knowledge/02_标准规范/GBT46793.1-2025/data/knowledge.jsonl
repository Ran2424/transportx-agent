{"schema_version": "1.0.0", "knowledge_id": "K-GBT46793.1-2025-000001", "doc_id": "GBT46793.1-2025", "statement": "本文件确立了突发事件应急预案的编制原则,规定了应急预案分类、编制流程和编制内容。本文件适用于政府及其部门、单位和基层组织突发事件应急预案编制工作。", "knowledge_type": "fact", "normative_force": "informational", "source_modality": null, "conditions": [], "actors": [], "objects": [], "actions": [], "applicable_stages": [], "topics": ["应急管理"], "scenarios": [], "source_refs": [{"node_id": "GBT46793.1-2025@1", "pdf_page": 7, "printed_page": "1", "source_file": "source/original.pdf"}], "derivation": "extractive", "confidence": 0.95, "verification_status": "page_aligned"}
