{"schema_version": "1.0.0", "knowledge_id": "K-GBT33170.2-2016-000027", "doc_id": "GBT33170.2-2016", "statement": "监测过程中发现枪支弹药、爆炸可疑物、腐蚀性与放射性物品等违禁物品，监测人员应当迅速报告现场公安机关进行处理。", "knowledge_type": "requirement", "normative_force": "recommended", "source_modality": "应当", "conditions": [], "actors": ["公安机关"], "objects": [], "actions": [], "applicable_stages": ["活动期间"], "topics": ["公安机关"], "scenarios": [], "source_refs": [{"node_id": "GBT33170.2-2016@6.2.6", "pdf_page": 6, "printed_page": "3", "source_file": "source/original.pdf"}], "derivation": "extractive", "confidence": 0.95, "verification_status": "page_aligned"}
{"schema_version": "1.0.0", "knowledge_id": "K-GBT33170.2-2016-000028", "doc_id": "GBT33170.2-2016", "statement": "活动范围监测是指对人员和车辆在允许进入区域内的行、以及依据对允许进入区域的授权等级做出的超出范围的行为进行监测。", "knowledge_type": "definition", "normative_force": "informational", "source_modality": "是指", "conditions": [], "actors": [], "objects": [], "actions": [], "applicable_stages": [], "topics": [], "scenarios": [], "source_refs": [{"node_id": "GBT33170.2-2016@6.3.1", "pdf_page": 7, "printed_page": "4", "source_file": "source/original.pdf"}], "derivation": "extractive", "confidence": 0.95, "verification_status": "page_aligned"}
{"schema_version": "1.0.0", "knowledge_id": "K-GBT33170.2-2016-000029", "doc_id": "GBT33170.2-2016", "statement": "人员和车辆在允许进入区域内的需要监测的行为包括徘徊、不当停靠、突然加速运动、逆行、接近重要物品设施等。", "knowledge_type": "fact", "normative_force": "informational", "source_modality": null, "conditions": [], "actors": [], "objects": [], "actions": [], "applicable_stages": [], "topics": [], "scenarios": [], "source_refs": [{"node_id": "GBT33170.2-2016@6.3.2", "pdf_page": 7, "printed_page": "4", "source_file": "source/original.pdf"}], "derivation": "extractive", "confidence": 0.95, "verification_status": "page_aligned"}
