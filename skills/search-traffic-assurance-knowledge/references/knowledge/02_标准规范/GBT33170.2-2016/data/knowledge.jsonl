{"schema_version": "1.0.0", "knowledge_id": "K-GBT33170.2-2016-000040", "doc_id": "GBT33170.2-2016", "statement": "进出口（闸机）处、通道进出口处、重点场馆进出口、售票口排队区域、站台候车区域、楼梯出入口、扶梯出入口、重要交叉路口、周界点、地下通道、行人天桥等点位处以及其他活动现场重要位置宜设置监测点位。", "knowledge_type": "recommendation", "normative_force": "recommended", "source_modality": "宜", "conditions": [], "actors": [], "objects": [], "actions": [], "applicable_stages": ["入场", "活动期间"], "topics": ["活动场馆", "道路交通", "集散通道"], "scenarios": [], "source_refs": [{"node_id": "GBT33170.2-2016@6.6.2", "pdf_page": 7, "printed_page": "4", "source_file": "source/original.pdf"}], "derivation": "extractive", "confidence": 0.95, "verification_status": "page_aligned"}
