{"schema_version": "1.0.0", "knowledge_id": "K-GBT33170.2-2016-000032", "doc_id": "GBT33170.2-2016", "statement": "监测的重点主要选取不同授权等级的交界处，重要物品设施区域、禁止进入区域等。", "knowledge_type": "prohibition", "normative_force": "prohibited", "source_modality": "禁止", "conditions": [], "actors": [], "objects": [], "actions": [], "applicable_stages": [], "topics": [], "scenarios": [], "source_refs": [{"node_id": "GBT33170.2-2016@6.3.5", "pdf_page": 7, "printed_page": "4", "source_file": "source/original.pdf"}], "derivation": "extractive", "confidence": 0.95, "verification_status": "page_aligned"}
{"schema_version": "1.0.0", "knowledge_id": "K-GBT33170.2-2016-000033", "doc_id": "GBT33170.2-2016", "statement": "！监测的措施采取人防、物防、技防相结合的手段，对于人员和车辆在允许进入区域内的徘徊、不当停靠、突然加速、逆行、接近重要物品设施等行能够有效提示，对于人员和车辆进入超出授权等级允许区域的行力能够及时发出警示。", "knowledge_type": "fact", "normative_force": "informational", "source_modality": null, "conditions": [], "actors": [], "objects": [], "actions": [], "applicable_stages": [], "topics": [], "scenarios": [], "source_refs": [{"node_id": "GBT33170.2-2016@6.3.6", "pdf_page": 7, "printed_page": "4", "source_file": "source/original.pdf"}], "derivation": "extractive", "confidence": 0.95, "verification_status": "page_aligned"}
{"schema_version": "1.0.0", "knowledge_id": "K-GBT33170.2-2016-000034", "doc_id": "GBT33170.2-2016", "statement": "人群聚集监测是指对大型活动场地内易产生人群聚集的区域范围进行人群聚集和拥挤现象的监测。", "knowledge_type": "definition", "normative_force": "informational", "source_modality": "是指", "conditions": [], "actors": [], "objects": [], "actions": [], "applicable_stages": [], "topics": ["人群拥挤", "人群管控"], "scenarios": ["人群拥挤"], "source_refs": [{"node_id": "GBT33170.2-2016@6.4.1", "pdf_page": 7, "printed_page": "4", "source_file": "source/original.pdf"}], "derivation": "extractive", "confidence": 0.95, "verification_status": "page_aligned"}
