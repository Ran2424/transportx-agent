{"schema_version": "1.0.0", "knowledge_id": "K-GBT33170.2-2016-000009", "doc_id": "GBT33170.2-2016", "statement": "在大型活动中，于需要提防的危险发生之前，根据以往总结的规律或观测得到的可能性前兆，向接受方发出紧急信号，报告危险情况，以避免危害在不知情或准备不足的情况下发生，从而最大程度地减低危害所造成的损失的行为。", "knowledge_type": "fact", "normative_force": "informational", "source_modality": null, "conditions": [], "actors": [], "objects": [], "actions": [], "applicable_stages": ["活动期间"], "topics": [], "scenarios": [], "source_refs": [{"node_id": "GBT33170.2-2016@3.6", "pdf_page": 4, "printed_page": "1", "source_file": "source/original.pdf"}], "derivation": "extractive", "confidence": 0.95, "verification_status": "page_aligned"}
{"schema_version": "1.0.0", "knowledge_id": "K-GBT33170.2-2016-000010", "doc_id": "GBT33170.2-2016", "statement": "根据大型活动预警信息类型或突发事件类型的不同，而采取不同的控制发展和减轻影响的措施。", "knowledge_type": "fact", "normative_force": "informational", "source_modality": null, "conditions": [], "actors": [], "objects": [], "actions": [], "applicable_stages": [], "topics": ["应急管理"], "scenarios": [], "source_refs": [{"node_id": "GBT33170.2-2016@3.7", "pdf_page": 5, "printed_page": "2", "source_file": "source/original.pdf"}], "derivation": "extractive", "confidence": 0.95, "verification_status": "page_aligned"}
