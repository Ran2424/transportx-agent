{"schema_version": "1.0.0", "knowledge_id": "K-GBT33170.2-2016-000036", "doc_id": "GBT33170.2-2016", "statement": "人群聚集监测的重点是在活动中心场地及狭窄通道、出人口、上下坡、楼梯、桥梁、涵洞、观景场所等易产生人群聚集的区域。", "knowledge_type": "fact", "normative_force": "informational", "source_modality": null, "conditions": [], "actors": [], "objects": [], "actions": [], "applicable_stages": ["活动期间"], "topics": ["人群拥挤", "人群管控"], "scenarios": ["人群拥挤"], "source_refs": [{"node_id": "GBT33170.2-2016@6.4.3", "pdf_page": 7, "printed_page": "4", "source_file": "source/original.pdf"}], "derivation": "extractive", "confidence": 0.95, "verification_status": "page_aligned"}
