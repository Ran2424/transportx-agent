          "应急管理",
          "恢复",
          "设施故障",
          "轨道交通"
        ],
        "children": []
      },
      {
        "node_id": "SH-RAIL-TRANSIT-SERVICE-RULES-2025@第三章",
        "number": "第三章",
        "title": "第三章",
        "node_type": "chapter",
        "page_span": null,
        "summary": "客运服务",
        "tags": [],
        "children": [
          {
            "node_id": "SH-RAIL-TRANSIT-SERVICE-RULES-2025@第十条",
