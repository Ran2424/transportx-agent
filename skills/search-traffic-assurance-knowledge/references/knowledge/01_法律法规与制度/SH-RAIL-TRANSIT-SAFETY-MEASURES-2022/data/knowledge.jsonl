{"schema_version": "1.0.0", "knowledge_id": "K-SH-RAIL-TRANSIT-SAFETY-MEASURES-2022-000051", "doc_id": "SH-RAIL-TRANSIT-SAFETY-MEASURES-2022", "statement": "(施行日期)\n\n本办法自２０１０年３月１日起施行.\n报送:国务院,市人大常委会.\n主送:各区人民政府,市政府各委、办、局.\n抄送:市委各部门,市政协办公厅,市纪委监委,市高院,市检察院.\n上海市人民政府办公厅 ２０２２年１月２８日印发\n—０２—", "knowledge_type": "fact", "normative_force": "informational", "source_modality": null, "conditions": [], "actors": [], "objects": [], "actions": [], "applicable_stages": [], "topics": [], "scenarios": [], "source_refs": [{"node_id": "SH-RAIL-TRANSIT-SAFETY-MEASURES-2022@第三十二条", "pdf_page": 20, "printed_page": null, "source_file": "source/original.pdf"}], "derivation": "extractive", "confidence": 0.95, "verification_status": "page_aligned"}
