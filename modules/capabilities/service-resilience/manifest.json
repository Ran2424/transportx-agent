{
  "manifestVersion": 2,
  "id": "com.transportx.service-resilience",
  "name": "City Service Resilience",
  "version": "0.1.0",
  "type": "capability",
  "platformVersion": ">=3.24.2 <4.0.0",
  "dependencies": [
    "com.transportx.geo",
    "com.transportx.canvas",
    "com.transportx.document",
    "com.transportx.citation",
    "com.transportx.interaction",
    "com.transportx.tool-activation"
  ],
  "entrypoints": {
    "piExtensions": ["extensions/pi-service-resilience/index.ts"],
    "skills": ["skills/service-stress-test/SKILL.md", "skills/decision-investigation/SKILL.md"]
  },
  "contributes": {
    "artifactTypes": ["resilience.pressure-test", "resilience.investigation", "resilience.observation-alignment"]
  },
  "presentation": {
    "defaultLocale": "zh-CN",
    "locales": {
      "zh-CN": {
        "name": "城市服务韧性",
        "description": "检验道路与设施中断下的服务缺口，比较应对方案，并找出可能改变选择的调查。",
        "features": ["按时段计算可达性和容量缺口", "比较中断情景与恢复方案", "按决策期限评估调查价值", "导入离线路网和调查表"]
      },
      "en-US": {
        "name": "City Service Resilience",
        "description": "Compare service shortfalls under disruptions and identify investigations that could inform a choice.",
        "features": ["Check time-sliced accessibility and capacity", "Compare disruption and recovery plans", "Rank investigations against the decision window", "Import offline networks and surveys"]
      }
    }
  }
}
