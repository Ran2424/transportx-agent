          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "maxItems": 8,
        "uniqueItems": true,
        "description": "Optional receipt IDs issued by other successful tools in this turn. They are references and do not count as source evidence."
      }
    },
    "additionalProperties": false
  },
  "output": {
    "protocol": "transportx-evidence-analysis",
    "version": 1,
    "detailsKind": "analysis-completion"
