{
  "name": "pi-traffic-workspace",
  "version": "3.0.8",
  "description": "TransportX Traffic Agent 本地交通分析桌面工作台",
  "main": "dist-desktop/main.js",
  "keywords": [
    "pi",
    "coding-agent",
    "web-ui",
    "rpc",
    "standalone",
    "traffic"
  ],
  "author": "deflating",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ran2424/pi-traffic-workspace.git"
  },
  "bin": {
    "pi-traffic-workspace": "./bin/tau.js"
  },
  "files": [
    "bin",
    "public",
    "prompts",
    "modules",
    "docs/**/*.md",
    "src",
    "dist/web",
    "scripts/postbuild-layout.mjs",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.server.json",
    "tsconfig.public.json",
    "tsconfig.web.json",
    "tsconfig.extensions.json"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web && npm run build:react && npm run build:geo && npm run build:desktop",
    "build:server": "tsc -p tsconfig.server.json && node scripts/postbuild-layout.mjs server",
    "build:web": "tsc -p tsconfig.public.json && node scripts/postbuild-layout.mjs public",
    "build:react": "vite build",
    "build:geo": "esbuild src/public/visualization/geo/geo-runtime-entry.ts --bundle --format=esm --target=es2022 --outfile=public/geo-runtime.js",
    "build:desktop": "tsc -p tsconfig.desktop.json",
    "desktop:dev": "npm run build && electron .",
    "desktop:dir": "npm run build && node desktop/scripts/prepare-runtime.mjs && electron-builder --config desktop/electron-builder.yml --dir",
    "desktop:pack": "node desktop/scripts/check-mac-release.mjs && npm run build && node desktop/scripts/prepare-runtime.mjs && electron-builder --config desktop/electron-builder.yml",
    "dev:web": "vite --config vite.config.ts",
    "prepare": "npm run build",
    "typecheck": "npm run typecheck:server && npm run typecheck:web && npm run typecheck:react && npm run typecheck:extensions && npm run typecheck:desktop && npm run typecheck:test",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.public.json --noEmit",
    "typecheck:react": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:extensions": "tsc -p tsconfig.extensions.json --noEmit",
    "typecheck:desktop": "tsc -p tsconfig.desktop.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && node --test",
    "test:pi-smoke": "npm run build:server && node scripts/pi-rpc-smoke.mjs",
    "eval:traffic": "npm run build && node scripts/eval/run-traffic-agent-eval.mjs --mode headless",
    "eval:traffic:tasks": "npm run build && node scripts/eval/run-traffic-agent-eval.mjs --mode headless --kind task",
    "eval:traffic:grade": "node scripts/eval/grade-traffic-agent-eval.mjs",
    "test:react-smoke": "npm run build && node scripts/react-smoke.mjs",
    "test:desktop-smoke": "npm run build && node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@radix-ui/react-dialog": "^1.1.20",
    "i18next": "^26.3.6",
    "katex": "^0.18.1",
    "mermaid": "^11.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "shiki": "^4.3.1",
    "typebox": "^1.3.6",
    "ws": "^8.16.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "maplibre-gl": "^5.24.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
