{
  "name": "pi-traffic-workspace",
  "version": "1.25.0",
  "description": "交通 Agent 浏览器工作台，基于 Pi Tau Web Server 管理多路 Pi RPC 会话",
  "keywords": [
    "pi",
    "coding-agent",
    "web-ui",
    "rpc",
    "standalone",
    "traffic"
  ],
  "author": "deflating",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ran2424/pi-traffic-workspace.git"
  },
  "bin": {
    "pi-traffic-workspace": "./bin/tau.js"
  },
  "files": [
    "bin",
    "public",
    "extensions",
    "skills",
    "prompts",
    "docs/*.md",
    "src",
    "tsconfig.json",
    "tsconfig.server.json",
    "tsconfig.public.json",
    "tsconfig.extensions.json"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web && npm run build:geo",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "tsc -p tsconfig.public.json",
    "build:geo": "esbuild src/public/visualization/geo/geo-runtime-entry.ts --bundle --format=esm --target=es2022 --outfile=public/geo-runtime.js",
    "prepare": "npm run build",
    "typecheck": "npm run typecheck:server && npm run typecheck:web && npm run typecheck:extensions && npm run typecheck:test",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.public.json --noEmit",
    "typecheck:extensions": "tsc -p tsconfig.extensions.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && node --test",
    "test:pi-smoke": "npm run build:server && TAU_RUN_PI_SMOKE=1 node --test test/pi-rpc-smoke.test.ts",
    "test:browser-smoke": "npm run build && node scripts/browser-smoke.mjs",
    "test:browser-baseline": "npm run build && node scripts/browser-baseline.mjs"
  },
  "dependencies": {
    "typebox": "^1.3.6",
    "ws": "^8.16.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.10 <0.81.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "maplibre-gl": "^5.24.0",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3"
  }
}
