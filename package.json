{
  "name": "transportx-agent",
  "version": "3.2.0",
  "description": "TransportX Agent 本地交通分析桌面工作台",
  "main": "dist-desktop/main.js",
  "keywords": [
    "pi",
    "coding-agent",
    "web-ui",
    "rpc",
    "standalone",
    "traffic"
  ],
  "author": "deflating",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ran2424/transportx-agent.git"
  },
  "bin": {
    "transportx-agent": "./bin/tau.js",
    "transportx": "./bin/transportx.js"
  },
  "files": [
    "bin",
    "public",
    "modules",
    "!modules/installable",
    "!modules/installable/**",
    "docs/**/*.md",
    "src",
    "dist/web",
    "scripts/postbuild-layout.mjs",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.server.json",
    "tsconfig.public.json",
    "tsconfig.web.json",
    "tsconfig.extensions.json"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web && npm run build:react && npm run build:desktop",
    "build:server": "tsc -p tsconfig.server.json && node scripts/postbuild-layout.mjs server",
    "build:web": "tsc -p tsconfig.public.json && node scripts/postbuild-layout.mjs public",
    "build:react": "vite build",
    "build:desktop": "tsc -p tsconfig.desktop.json",
    "desktop:dev": "npm run build && electron .",
    "desktop:dir": "npm run build && node desktop/scripts/prepare-runtime.mjs && electron-builder --config desktop/electron-builder.yml --dir",
    "desktop:pack": "node desktop/scripts/check-desktop-release.mjs && npm run build && node desktop/scripts/prepare-runtime.mjs && electron-builder --config desktop/electron-builder.yml",
    "desktop:dir:allow-unsigned": "node desktop/scripts/check-desktop-release.mjs --allow-unsigned && npm run build && node desktop/scripts/prepare-runtime.mjs && electron-builder --config desktop/electron-builder.yml --dir",
    "video:pack": "node desktop/scripts/package-video-capability.mjs",
    "dev:web": "vite --config vite.config.ts",
    "prepare": "npm run build",
    "typecheck": "npm run typecheck:server && npm run typecheck:web && npm run typecheck:react && npm run typecheck:extensions && npm run typecheck:desktop && npm run typecheck:test",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.public.json --noEmit",
    "typecheck:react": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:extensions": "tsc -p tsconfig.extensions.json --noEmit",
    "typecheck:desktop": "tsc -p tsconfig.desktop.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "npm run test:core",
    "test:core": "npm run build && node --test test/agent-host-desktop.test.ts test/transportx-cli.test.ts",
    "test:pi-smoke": "npm run build:server && node scripts/pi-rpc-smoke.mjs",
    "eval:traffic": "npm run build && node scripts/eval/run-traffic-agent-eval.mjs --mode headless",
    "eval:traffic:tasks": "npm run build && node scripts/eval/run-traffic-agent-eval.mjs --mode headless --kind task",
    "eval:traffic:grade": "node scripts/eval/grade-traffic-agent-eval.mjs",
    "test:web": "npm run build && node scripts/react-smoke.mjs",
    "test:platform:macos": "npm run build && node scripts/macos-desktop-smoke.mjs",
    "test:platform:windows": "node scripts/windows-platform-smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@radix-ui/react-dialog": "^1.1.20",
    "@silurus/ooxml": "0.87.0",
    "i18next": "^26.3.6",
    "katex": "^0.18.1",
    "mermaid": "^11.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "shiki": "^4.3.1",
    "typebox": "^1.3.6",
    "ws": "^8.16.0",
    "xlsx": "^0.18.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "maplibre-gl": "^5.24.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "yazl": "^3.3.1"
  }
}
