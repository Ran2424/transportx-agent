{
  "name": "pi-traffic-workspace",
  "version": "2.11.0",
  "description": "交通 Agent 浏览器工作台，基于 Pi Tau Web Server 管理多路 Pi RPC 会话",
  "keywords": [
    "pi",
    "coding-agent",
    "web-ui",
    "rpc",
    "standalone",
    "traffic"
  ],
  "author": "deflating",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ran2424/pi-traffic-workspace.git"
  },
  "bin": {
    "pi-traffic-workspace": "./bin/tau.js"
  },
  "files": [
    "bin",
    "public",
    "extensions",
    "skills",
    "prompts",
    "docs/*.md",
    "src",
    "dist/web",
    "scripts/postbuild-layout.mjs",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.server.json",
    "tsconfig.public.json",
    "tsconfig.web.json",
    "tsconfig.extensions.json"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web && npm run build:react && npm run build:geo",
    "build:server": "tsc -p tsconfig.server.json && node scripts/postbuild-layout.mjs server",
    "build:web": "tsc -p tsconfig.public.json && node scripts/postbuild-layout.mjs public",
    "build:react": "vite build",
    "build:geo": "esbuild src/public/visualization/geo/geo-runtime-entry.ts --bundle --format=esm --target=es2022 --outfile=public/geo-runtime.js",
    "dev:web": "vite --config vite.config.ts",
    "prepare": "npm run build",
    "typecheck": "npm run typecheck:server && npm run typecheck:web && npm run typecheck:react && npm run typecheck:extensions && npm run typecheck:test",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.public.json --noEmit",
    "typecheck:react": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:extensions": "tsc -p tsconfig.extensions.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && node --test",
    "test:pi-smoke": "npm run build:server && node scripts/pi-rpc-smoke.mjs",
    "test:react-smoke": "npm run build && node scripts/react-smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.20",
    "katex": "^0.18.1",
    "mermaid": "^11.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.3.1",
    "typebox": "^1.3.6",
    "ws": "^8.16.0",
    "xlsx": "^0.18.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.10 <0.81.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "maplibre-gl": "^5.24.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
